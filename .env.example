# Copy to .env (never commit). Placeholders only.
# --- apps/api ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://alterego:alterego@localhost:5432/alterego
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
SENTRY_DSN=
# Field-level encryption keys: key_id:base64(32 random bytes), comma separated; the first one encrypts.
# python -c "import os,base64;print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEYS=
# LLM: "fake" is the only provider implemented so far. Model id is config, never hardcoded.
LLM_PROVIDER=fake
FAKE_LLM_DELAY_MS=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# --- apps/web ---
VITE_API_BASE_URL=http://localhost:8010
